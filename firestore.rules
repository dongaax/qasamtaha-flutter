rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // عضو في المجموعة دي؟
    function isMember(gid) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(db)/documents/groups/$(gid)).data.members;
    }

    // يعدّل أو يحذف المصروف: صاحب المجموعة أو اللي ضاف المصروف
    function canManage(gid, exp) {
      return request.auth.uid == get(/databases/$(db)/documents/groups/$(gid)).data.createdBy
        || request.auth.uid == exp.get('createdBy', exp.paidBy);
    }

    match /users/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || request.auth.token.firebase.sign_in_provider != 'anonymous');
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /groups/{gid} {
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.createdBy == request.auth.uid;

      allow read: if request.auth != null && request.auth.uid in resource.data.members;

      // الأعضاء يضيفوا أعضاء أو أشخاص بالاسم (members وguests بس)
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'guests']);

      match /expenses/{eid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid) && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(gid) && canManage(gid, resource.data)
                      && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null);
        allow delete: if isMember(gid) && canManage(gid, resource.data);
      }

      match /settlements/{sid} {
        allow read, write: if isMember(gid);
      }
    }
  }
}